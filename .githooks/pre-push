#!/usr/bin/env bash
# Lint, dependency check and tests before every push: `just pre-push`.
# CI runs the same recipes, plus macOS and Linux, the minimum Rust version
# and a release smoke run. Enable with: git config core.hooksPath .githooks
set -euo pipefail

if ! command -v just > /dev/null; then
    echo "pre-push: needs just (brew install just)" >&2
    exit 1
fi

exec just pre-push
